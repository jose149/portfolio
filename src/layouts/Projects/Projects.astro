---
import "./Projects.scss";

import Project from "../../components/Project/Project.astro";
import SectionHeading from "../../components/SectionHeading/SectionHeading.astro";

import { getProjects } from "./Projects.data";

import { getLocaleFromPath, getTranslations } from "../../i18n/i18n";

const locale = getLocaleFromPath(Astro.url.pathname);

const t = getTranslations(locale);

const projects = getProjects(locale);

const PROJECTS_REPOSITORY = "https://github.com/jose149?tab=repositories";
---

<section id="projects" class="projects" aria-labelledby="projects-title">
  <SectionHeading
    id="projects-title"
    title={t.projects.title}
    href={PROJECTS_REPOSITORY}
    linkLabel={t.projects.allProjects}
    external
  />

  <div class="projects__content">
    {
      projects.map((project, index) => (
        <Project
          number={index + 1}
          total={projects.length}
          project={project}
          reverse={index % 2 !== 0}
        />
      ))
    }
  </div>
</section>
