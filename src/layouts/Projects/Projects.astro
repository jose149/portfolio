---
import "./Projects.scss";

import Project from "../../components/Project/Project.astro";

import { projects } from "./Projects.data.ts";
import SectionHeading from "../../components/SectionHeading/SectionHeading.astro";

interface Props {
  archiveHref?: string;
}

const { archiveHref = "/projects" } = Astro.props;
---

<section id="projects" class="projects" aria-labelledby="projects-title">
  <SectionHeading
    id="projects-title"
    title="Projects"
    href={archiveHref}
    linkLabel="All projects"
  />

  <div class="projects__content">
    {
      projects.map((project, index) => (
        <Project
          number={index + 1}
          total={projects.length}
          project={project}
          reverse={!!(index % 2)}
        />
      ))
    }
  </div>
</section>
