---
import "./Navbar.scss";

import {
  getLocaleFromPath,
  getLocalizedPath,
  getTranslations,
  supportedLocales,
} from "../../i18n/i18n";

import { localeConfig } from "../../i18n/translations";

const locale = getLocaleFromPath(Astro.url.pathname);

const t = getTranslations(locale);

const navigationItems = [
  {
    label: t.navbar.home,
    href: "#top",
    section: "top",
  },
  {
    label: t.navbar.projects,
    href: "#projects",
    section: "projects",
  },
  {
    label: t.navbar.about,
    href: "#about",
    section: "about",
  },
  {
    label: t.navbar.experience,
    href: "#experience",
    section: "experience",
  },
  {
    label: t.navbar.contact,
    href: "#contact",
    section: "contact",
  },
];

const languageOptions = supportedLocales.map((language) => ({
  locale: language,

  ...localeConfig[language],

  href: getLocalizedPath(Astro.url.pathname, language),
}));
---

<header
  class="navbar"
  data-navbar
  data-menu-open-label={t.navbar.mobile.open}
  data-menu-close-label={t.navbar.mobile.close}
>
  <div class="navbar__inner">
    <!-- ==================================================
         BRAND
    =================================================== -->

    <a
      href="#top"
      class="navbar__brand"
      data-scroll-link
      aria-label={t.navbar.brandLabel}
    >
      <span class="navbar__monogram"> JC </span>
    </a>

    <!-- ==================================================
         DESKTOP NAVIGATION
    =================================================== -->

    <nav class="navbar__navigation" aria-label={t.navbar.navigationLabel}>
      <ul class="navbar__list">
        {
          navigationItems.map((item, index) => (
            <li>
              {index === navigationItems.length - 1 ? (
                <a
                  href="#contact"
                  class:list={[
                    "navbar__cta",
                    index === 0 && "navbar__link--active",
                  ]}
                  data-scroll-link
                >
                  <span>{t.navbar.contact}</span>
                </a>
              ) : (
                <a
                  href={item.href}
                  class:list={[
                    "navbar__link",
                    index === 0 && "navbar__link--active",
                  ]}
                  data-scroll-link
                  data-nav-section={item.section}
                  aria-current={index === 0 ? "page" : undefined}
                >
                  <span>{item.label}</span>
                </a>
              )}
            </li>
          ))
        }
      </ul>
    </nav>

    <!-- ==================================================
         ACTIONS
    =================================================== -->

    <div class="navbar__actions">
      <!-- ================================================
           LANGUAGE SELECTOR
      ================================================= -->

      <div class="navbar__language-selector" data-language-selector>
        <button
          type="button"
          class="navbar__language"
          data-language-button
          aria-label={t.navbar.language.label}
          aria-haspopup="true"
          aria-expanded="false"
          aria-controls="language-menu"
        >
          <span>
            {localeConfig[locale].shortLabel}
          </span>
        </button>

        <div
          id="language-menu"
          class="navbar__language-menu"
          data-language-menu
          aria-hidden="true"
          inert
        >
          <ul>
            {
              languageOptions.map((language) => (
                <li>
                  <a
                    href={language.href}
                    hreflang={language.locale}
                    lang={language.locale}
                    data-language-option
                    class:list={[
                      "navbar__language-option",

                      language.locale === locale &&
                        "navbar__language-option--active",
                    ]}
                    aria-current={
                      language.locale === locale ? "true" : undefined
                    }
                  >
                    <span>{language.label}</span>

                    <span class="navbar__language-code">
                      {language.shortLabel}
                    </span>
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </div>

      <!-- ================================================
           CONTACT CTA
      ================================================= -->
    </div>

    <!-- ==================================================
         MOBILE BUTTON
    =================================================== -->

    <button
      type="button"
      class="navbar__menu-button"
      data-menu-button
      aria-label={t.navbar.mobile.open}
      aria-expanded="false"
      aria-controls="mobile-navigation"
    >
      <span></span>
      <span></span>
    </button>
  </div>

  <!-- ==================================================
       MOBILE MENU
  =================================================== -->

  <div
    id="mobile-navigation"
    class="navbar__mobile-menu"
    data-mobile-menu
    aria-hidden="true"
  >
    <div class="navbar__mobile-menu-inner">
      <nav aria-label={t.navbar.mobile.navigationLabel}>
        <ul>
          {
            navigationItems.map((item, index) => (
              <li>
                <a
                  href={item.href}
                  class:list={[
                    "navbar__mobile-link",

                    index === 0 && "navbar__mobile-link--active",
                  ]}
                  data-scroll-link
                  data-nav-section={item.section}
                  aria-current={index === 0 ? "page" : undefined}
                >
                  <span>{item.label}</span>

                  <span aria-hidden="true">↗</span>
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <!-- ================================================
           MOBILE LANGUAGES
      ================================================= -->

      <div class="navbar__mobile-languages">
        {
          languageOptions.map((language) => (
            <a
              href={language.href}
              hreflang={language.locale}
              lang={language.locale}
              data-language-option
              class:list={[
                "navbar__mobile-language",

                language.locale === locale && "navbar__mobile-language--active",
              ]}
              aria-current={language.locale === locale ? "true" : undefined}
            >
              {language.shortLabel}
            </a>
          ))
        }
      </div>
    </div>
  </div>
</header>

<script>
  const navbar = document.querySelector<HTMLElement>("[data-navbar]");

  if (navbar) {
    const scrollLinks = [
      ...navbar.querySelectorAll<HTMLAnchorElement>("[data-scroll-link]"),
    ];

    const sectionLinks = [
      ...navbar.querySelectorAll<HTMLAnchorElement>("[data-nav-section]"),
    ];

    const menuButton =
      navbar.querySelector<HTMLButtonElement>("[data-menu-button]");

    const mobileMenu = navbar.querySelector<HTMLElement>("[data-mobile-menu]");

    const languageSelector = navbar.querySelector<HTMLElement>(
      "[data-language-selector]",
    );

    const languageButton = navbar.querySelector<HTMLButtonElement>(
      "[data-language-button]",
    );

    const languageMenu = navbar.querySelector<HTMLElement>(
      "[data-language-menu]",
    );

    const languageOptions = [
      ...navbar.querySelectorAll<HTMLAnchorElement>("[data-language-option]"),
    ];

    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

    const openMenuLabel = navbar.dataset.menuOpenLabel ?? "Open navigation";

    const closeMenuLabel = navbar.dataset.menuCloseLabel ?? "Close navigation";

    let ticking = false;

    // ==================================================
    // LANGUAGE MENU
    // ==================================================

    const closeLanguageMenu = () => {
      if (!languageSelector || !languageButton || !languageMenu) {
        return;
      }

      languageSelector.classList.remove("navbar__language-selector--open");

      languageButton.setAttribute("aria-expanded", "false");

      languageMenu.setAttribute("aria-hidden", "true");

      languageMenu.inert = true;
    };

    const openLanguageMenu = () => {
      if (!languageSelector || !languageButton || !languageMenu) {
        return;
      }

      languageSelector.classList.add("navbar__language-selector--open");

      languageButton.setAttribute("aria-expanded", "true");

      languageMenu.setAttribute("aria-hidden", "false");

      languageMenu.inert = false;
    };

    languageButton?.addEventListener("click", () => {
      const isOpen = languageSelector?.classList.contains(
        "navbar__language-selector--open",
      );

      if (isOpen) {
        closeLanguageMenu();

        return;
      }

      openLanguageMenu();
    });

    // ==================================================
    // LANGUAGE NAVIGATION
    // ==================================================

    languageOptions.forEach((option) => {
      option.addEventListener("click", (event) => {
        /*
         * The server does not receive hashes,
         * so preserve the current section manually.
         *
         * /en/#experience
         * ->
         * /es/#experience
         */

        const hash = window.location.hash;

        if (!hash) {
          return;
        }

        event.preventDefault();

        const url = new URL(option.href, window.location.origin);

        url.hash = hash;

        window.location.assign(url.toString());
      });
    });

    // ==================================================
    // MOBILE MENU
    // ==================================================

    const closeMobileMenu = () => {
      if (!menuButton || !mobileMenu) {
        return;
      }

      navbar.classList.remove("navbar--menu-open");

      menuButton.setAttribute("aria-expanded", "false");

      menuButton.setAttribute("aria-label", openMenuLabel);

      mobileMenu.setAttribute("aria-hidden", "true");
    };

    const openMobileMenu = () => {
      if (!menuButton || !mobileMenu) {
        return;
      }

      closeLanguageMenu();

      navbar.classList.add("navbar--menu-open");

      menuButton.setAttribute("aria-expanded", "true");

      menuButton.setAttribute("aria-label", closeMenuLabel);

      mobileMenu.setAttribute("aria-hidden", "false");
    };

    menuButton?.addEventListener("click", () => {
      const isOpen = navbar.classList.contains("navbar--menu-open");

      if (isOpen) {
        closeMobileMenu();
      } else {
        openMobileMenu();
      }
    });

    // ==================================================
    // CLICK OUTSIDE
    // ==================================================

    document.addEventListener("click", (event) => {
      if (!languageSelector) {
        return;
      }

      if (languageSelector.contains(event.target as Node)) {
        return;
      }

      closeLanguageMenu();
    });

    // ==================================================
    // ESCAPE
    // ==================================================

    document.addEventListener("keydown", (event) => {
      if (event.key !== "Escape") {
        return;
      }

      const languageOpen = languageSelector?.classList.contains(
        "navbar__language-selector--open",
      );

      if (languageOpen) {
        closeLanguageMenu();

        languageButton?.focus();

        return;
      }

      if (navbar.classList.contains("navbar--menu-open")) {
        closeMobileMenu();

        menuButton?.focus();
      }
    });

    // ==================================================
    // SCROLLED STATE
    // ==================================================

    const updateScrolledState = () => {
      navbar.classList.toggle("navbar--scrolled", window.scrollY > 16);
    };

    // ==================================================
    // ACTIVE SECTION
    // ==================================================

    const setActiveSection = (sectionId: string) => {
      sectionLinks.forEach((link) => {
        const active = link.dataset.navSection === sectionId;

        link.classList.toggle("navbar__link--active", active);

        link.classList.toggle("navbar__mobile-link--active", active);

        if (active) {
          link.setAttribute("aria-current", "page");
        } else {
          link.removeAttribute("aria-current");
        }
      });
    };

    const updateActiveSection = () => {
      /*
       * At the very top, Home
       * is always considered active.
       */

      if (window.scrollY < 80) {
        setActiveSection("top");

        return;
      }

      const activationPoint = navbar.offsetHeight + 120;

      const sectionIds = ["projects", "about", "experience", "contact"];

      let currentSection = "top";

      sectionIds.forEach((sectionId) => {
        const section = document.getElementById(sectionId);

        if (!section) return;

        const rect = section.getBoundingClientRect();

        if (rect.top <= activationPoint && rect.bottom > activationPoint) {
          currentSection = sectionId;
        }
      });

      /*
       * Contact stays active
       * at the end of the document.
       */

      const isAtBottom =
        window.innerHeight + window.scrollY >=
        document.documentElement.scrollHeight - 4;

      if (isAtBottom) {
        currentSection = "contact";
      }

      setActiveSection(currentSection);
    };

    // ==================================================
    // SCROLL UPDATE
    // ==================================================

    const updateNavbar = () => {
      updateScrolledState();
      updateActiveSection();

      ticking = false;
    };

    window.addEventListener(
      "scroll",
      () => {
        if (ticking) return;

        ticking = true;

        requestAnimationFrame(updateNavbar);
      },
      {
        passive: true,
      },
    );

    // ==================================================
    // SMOOTH NAVIGATION
    // ==================================================

    scrollLinks.forEach((link) => {
      link.addEventListener("click", (event) => {
        const href = link.getAttribute("href");

        if (!href || !href.startsWith("#")) {
          return;
        }

        event.preventDefault();

        // ==========================================
        // HOME
        // ==========================================

        if (href === "#top") {
          window.scrollTo({
            top: 0,

            behavior: reducedMotion.matches ? "auto" : "smooth",
          });

          history.replaceState(null, "", href);

          closeMobileMenu();

          return;
        }

        // ==========================================
        // OTHER SECTIONS
        // ==========================================

        const target = document.querySelector<HTMLElement>(href);

        if (!target) return;

        const navbarHeight = navbar.offsetHeight;

        const offset = 24;

        const targetPosition =
          target.getBoundingClientRect().top +
          window.scrollY -
          navbarHeight -
          offset;

        window.scrollTo({
          top: Math.max(targetPosition, 0),

          behavior: reducedMotion.matches ? "auto" : "smooth",
        });

        history.replaceState(null, "", href);

        closeMobileMenu();
      });
    });

    // ==================================================
    // RESIZE
    // ==================================================

    window.addEventListener("resize", () => {
      if (window.innerWidth >= 768) {
        closeMobileMenu();
      }

      closeLanguageMenu();

      updateActiveSection();
    });

    // ==================================================
    // INITIAL STATE
    // ==================================================

    updateNavbar();
  }
</script>
