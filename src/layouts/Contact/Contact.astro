---
import SectionHeading from "../../components/SectionHeading/SectionHeading.astro";

import { getLocaleFromPath, getTranslations } from "../../i18n/i18n";

import "./Contact.scss";

const locale = getLocaleFromPath(Astro.url.pathname);

const t = getTranslations(locale);

const contactItems = [
  {
    label: t.contact.items.email,

    value: "crespi.valero.jose@gmail.com",

    href: "mailto:crespi.valero.jose@gmail.com",

    icon: "email",
  },

  {
    label: t.contact.items.linkedin,

    value: "linkedin.com/in/jose-crespi-valero",

    href: "https://www.linkedin.com/in/jose-crespi-valero/",

    icon: "linkedin",
  },

  {
    label: t.contact.items.github,

    value: "github.com/jose149",

    href: "https://github.com/jose149",

    icon: "github",
  },

  {
    label: t.contact.items.location,

    value: t.contact.items.locationValue,

    icon: "location",
  },
];
---

<section class="contact" id="contact" aria-labelledby="contact-title">
  <!-- ==================================================
       HEADING
  =================================================== -->

  <SectionHeading id="contact-title" title={t.contact.title} />

  <!-- ==================================================
       CONTENT
  =================================================== -->

  <div class="contact__grid">
    <!-- =================================================
         CONTACT INFO
    ================================================== -->

    <aside class="contact-card">
      <div class="contact-card__top">
        <div class="contact-card__availability">
          <span class="contact-card__availability-dot" aria-hidden="true"
          ></span>

          <span>
            {t.contact.available}
          </span>
        </div>

        <h3 class="contact-card__title">
          {t.contact.availabilityText}
        </h3>
      </div>

      <div class="contact-card__divider"></div>

      <ul class="contact-card__list">
        {
          contactItems.map((item) => (
            <li class="contact-card__item">
              <span class="contact-card__icon" aria-hidden="true">
                {item.icon === "email" && (
                  <svg viewBox="0 0 24 24" fill="none">
                    <path
                      d="M4 6.5h16v11H4v-11Z"
                      stroke="currentColor"
                      stroke-width="1.4"
                    />

                    <path
                      d="m4.8 7.3 7.2 5.4 7.2-5.4"
                      stroke="currentColor"
                      stroke-width="1.4"
                    />
                  </svg>
                )}

                {item.icon === "linkedin" && (
                  <svg viewBox="0 0 24 24" fill="none">
                    <path d="M7 9v8" stroke="currentColor" stroke-width="1.5" />

                    <path
                      d="M7 6.8v.2"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                    />

                    <path
                      d="M11 17v-4.5c0-2 1.1-3.3 2.9-3.3 1.8 0 3.1 1.2 3.1 3.5V17"
                      stroke="currentColor"
                      stroke-width="1.5"
                    />
                  </svg>
                )}

                {item.icon === "github" && (
                  <svg viewBox="0 0 24 24" fill="none">
                    <path
                      d="M8.5 18.5c-3 .8-3-1.5-4.2-1.9"
                      stroke="currentColor"
                      stroke-width="1.4"
                      stroke-linecap="round"
                    />

                    <path
                      d="M16 20v-2.4c0-.8.3-1.5.8-2 2.7-.3 5.5-1.3 5.5-6a4.6 4.6 0 0 0-1.2-3.2 4.3 4.3 0 0 0-.1-3.2s-1-.3-3.4 1.2a11.8 11.8 0 0 0-6.2 0C9 2.9 8 3.2 8 3.2a4.3 4.3 0 0 0-.1 3.2 4.6 4.6 0 0 0-1.2 3.2c0 4.7 2.8 5.7 5.5 6 .5.5.8 1.2.8 2V20"
                      stroke="currentColor"
                      stroke-width="1.4"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    />
                  </svg>
                )}

                {item.icon === "location" && (
                  <svg viewBox="0 0 24 24" fill="none">
                    <path
                      d="M12 20s6-5.2 6-11a6 6 0 1 0-12 0c0 5.8 6 11 6 11Z"
                      stroke="currentColor"
                      stroke-width="1.4"
                    />

                    <circle
                      cx="12"
                      cy="9"
                      r="2"
                      stroke="currentColor"
                      stroke-width="1.4"
                    />
                  </svg>
                )}

                {item.icon === "working" && (
                  <svg viewBox="0 0 24 24" fill="none">
                    <rect
                      x="4"
                      y="5"
                      width="16"
                      height="11"
                      rx="1"
                      stroke="currentColor"
                      stroke-width="1.4"
                    />

                    <path
                      d="M8 20h8M12 16v4"
                      stroke="currentColor"
                      stroke-width="1.4"
                    />
                  </svg>
                )}
              </span>

              <span class="contact-card__label">{item.label}</span>

              {item.href ? (
                <a
                  class="contact-card__value contact-card__value--link"
                  href={item.href}
                  target={item.href.startsWith("http") ? "_blank" : undefined}
                  rel={
                    item.href.startsWith("http")
                      ? "noopener noreferrer"
                      : undefined
                  }
                >
                  {item.value}

                  <span class="contact-card__arrow" aria-hidden="true">
                    ↗
                  </span>
                </a>
              ) : (
                <span class="contact-card__value">{item.value}</span>
              )}
            </li>
          ))
        }
      </ul>

      <div class="contact-card__footer">
        <p>
          {t.contact.replyTime}
        </p>

        <div class="contact-card__monogram" aria-hidden="true">
          <span> JC </span>
        </div>
      </div>

      <div class="contact-card__lines" aria-hidden="true">
        <span></span>
        <span></span>
        <span></span>
      </div>
    </aside>

    <!-- =================================================
         FORM
    ================================================== -->

    <form
      class="contact-form"
      data-contact-form
      data-mail-name-label={t.contact.mail.name}
      data-mail-email-label={t.contact.mail.email}
      data-mail-company-label={t.contact.mail.company}
    >
      <div class="contact-form__row contact-form__row--split">
        <div class="contact-form__field">
          <label for="contact-name">
            {t.contact.form.name.label}
          </label>

          <input
            id="contact-name"
            name="name"
            type="text"
            autocomplete="name"
            placeholder={t.contact.form.name.placeholder}
            required
          />
        </div>

        <div class="contact-form__field">
          <label for="contact-email">
            {t.contact.form.email.label}
          </label>

          <input
            id="contact-email"
            name="email"
            type="email"
            autocomplete="email"
            placeholder={t.contact.form.email.placeholder}
            required
          />
        </div>
      </div>

      <div class="contact-form__field">
        <label for="contact-company">
          {t.contact.form.company.label}
        </label>

        <input
          id="contact-company"
          name="company"
          type="text"
          autocomplete="organization"
          placeholder={t.contact.form.company.placeholder}
        />
      </div>

      <div class="contact-form__field">
        <label for="contact-subject">
          {t.contact.form.subject.label}
        </label>

        <input
          id="contact-subject"
          name="subject"
          type="text"
          placeholder={t.contact.form.subject.placeholder}
          required
        />
      </div>

      <div class="contact-form__field">
        <label for="contact-message">
          {t.contact.form.message.label}
        </label>

        <textarea
          id="contact-message"
          name="message"
          rows="6"
          placeholder={t.contact.form.message.placeholder}
          required></textarea>
      </div>

      <button type="submit" class="contact-form__submit">
        <span>
          {t.contact.form.submit}
        </span>

        <span class="contact-form__submit-arrow" aria-hidden="true"> → </span>
      </button>

      <p class="contact-form__privacy">
        {t.contact.form.privacy}
      </p>
    </form>
  </div>
</section>

<script>
  const contactForm = document.querySelector<HTMLFormElement>(
    "[data-contact-form]",
  );

  contactForm?.addEventListener("submit", (event) => {
    event.preventDefault();

    const formData = new FormData(contactForm);

    const name = String(formData.get("name") ?? "").trim();

    const email = String(formData.get("email") ?? "").trim();

    const company = String(formData.get("company") ?? "").trim();

    const subject = String(formData.get("subject") ?? "").trim();

    const message = String(formData.get("message") ?? "").trim();

    const nameLabel = contactForm.dataset.mailNameLabel ?? "Name";

    const emailLabel = contactForm.dataset.mailEmailLabel ?? "Email";

    const companyLabel = contactForm.dataset.mailCompanyLabel ?? "Company";

    const body = [
      `${nameLabel}: ${name}`,
      `${emailLabel}: ${email}`,

      company ? `${companyLabel}: ${company}` : "",

      "",
      message,
    ]
      .filter(Boolean)
      .join("\n");

    const mailto =
      `mailto:hello@josecrespi.dev` +
      `?subject=${encodeURIComponent(subject)}` +
      `&body=${encodeURIComponent(body)}`;

    window.location.href = mailto;
  });
</script>
