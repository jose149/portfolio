---
import SectionHeading from "../../components/SectionHeading/SectionHeading.astro";

import {
  getExperienceCategoryLabels,
  getExperienceFilters,
  getExperienceItems,
} from "./Experience.data";

import {
  getLocaleFromPath,
  getTranslations,
} from "../../i18n/i18n";

import "./Experience.scss";

const JOSE_CV_SOURCE =
  "/Jose-Crespi-CV-EN.pdf";

const locale =
  getLocaleFromPath(
    Astro.url.pathname,
  );

const t =
  getTranslations(locale);

const experienceFilters =
  getExperienceFilters(locale);

const experienceCategoryLabels =
  getExperienceCategoryLabels(
    locale,
  );

const experienceItems =
  getExperienceItems(locale);
---

<section
  class="experience"
  id="experience"
  aria-labelledby="experience-title"
  data-experience-root
  data-details-label={t.experience.actions.details}
  data-close-label={t.experience.actions.close}
>
  <!-- ==================================================
       HEADER
  =================================================== -->

  <SectionHeading
    id="experience-title"
    title={t.experience.title}
    href={JOSE_CV_SOURCE}
    linkLabel={t.experience.resume}
    external
  />

  <!-- ==================================================
       FILTERS
  =================================================== -->

  <div class="experience__filters-shell">
    <div
      class="experience__filters"
      data-experience-filters
      aria-label={t.experience.filterAriaLabel}
    >
      <span
        class="experience__filter-indicator"
        data-experience-indicator
        aria-hidden="true"
      ></span>

      {
        experienceFilters.map(
          (filter, index) => (
            <button
              type="button"
              class:list={[
                "experience__filter",
                index === 0 &&
                  "experience__filter--active",
              ]}
              data-experience-filter={
                filter.value
              }
              data-experience-filter-index={
                index
              }
              aria-pressed={
                index === 0
                  ? "true"
                  : "false"
              }
            >
              <span>
                {filter.label}
              </span>
            </button>
          ),
        )
      }
    </div>
  </div>

  <!-- ==================================================
       TIMELINE
  =================================================== -->

  <div
    class="experience__timeline"
    data-experience-list
  >
    {
      experienceItems.map((item) => {
        const panelId =
          `experience-${item.id}-panel`;

        const isOpen =
          Boolean(item.defaultOpen);

        return (
          <article
            class:list={[
              "experience-item",
              isOpen &&
                "experience-item--expanded",
            ]}
            data-experience-item
            data-category={item.category}
          >
            <!-- DATE -->

            <div class="experience-item__date">
              <span class="experience-item__date-value">
                {item.startDate}

                {item.endDate && (
                  <>
                    <span aria-hidden="true">
                      {" — "}
                    </span>

                    {item.endDate}
                  </>
                )}
              </span>

              <span class="experience-item__category">
                {
                  experienceCategoryLabels[
                    item.category
                  ]
                }
              </span>
            </div>

            <!-- TIMELINE MARKER -->

            <div
              class="experience-item__marker"
              aria-hidden="true"
            >
              <span></span>
            </div>

            <!-- CONTENT -->

            <div class="experience-item__content">
              <button
                type="button"
                class="experience-item__toggle"
                data-experience-toggle
                aria-expanded={isOpen}
                aria-controls={panelId}
              >
                <span class="experience-item__identity">
                  <span class="experience-item__company">
                    {item.company}
                  </span>

                  <span class="experience-item__role">
                    {item.role}
                  </span>

                  {
                    item.team && (
                      <span class="experience-item__team">
                        {item.team}
                      </span>
                    )
                  }
                </span>

                <span class="experience-item__toggle-label">
                  <span data-experience-toggle-label>
                    {
                      isOpen
                        ? t.experience.actions.close
                        : t.experience.actions.details
                    }
                  </span>

                  <span
                    class="experience-item__toggle-icon"
                    aria-hidden="true"
                  >
                    {isOpen ? "−" : "+"}
                  </span>
                </span>
              </button>

              <!-- EXPANDED CONTENT -->

              <div
                id={panelId}
                class="experience-item__panel"
                data-experience-panel
                aria-hidden={!isOpen}
                inert={!isOpen}
              >
                <div class="experience-item__panel-inner">
                  <div class="experience-item__detail">
                    {
                      item.description && (
                        <p class="experience-item__description">
                          {item.description}
                        </p>
                      )
                    }

                    {
                      item.impact?.length && (
                        <div class="experience-item__impact">
                          <span class="experience-item__label">
                            {
                              t.experience.labels
                                .selectedImpact
                            }
                          </span>

                          <ul class="experience-item__impact-list">
                            {
                              item.impact.map(
                                (impact) => (
                                  <li>
                                    {impact}
                                  </li>
                                ),
                              )
                            }
                          </ul>
                        </div>
                      )
                    }
                  </div>

                  {
                    (item.stack?.length ||
                      item.relatedProject) && (
                      <aside class="experience-item__aside">
                        {
                          item.stack?.length && (
                            <div class="experience-item__stack">
                              <span class="experience-item__label">
                                {
                                  t.experience.labels
                                    .techStack
                                }
                              </span>

                              <ul class="experience-item__stack-list">
                                {
                                  item.stack.map(
                                    (
                                      technology,
                                    ) => (
                                      <li>
                                        {
                                          technology
                                        }
                                      </li>
                                    ),
                                  )
                                }
                              </ul>
                            </div>
                          )
                        }

                        {
                          item.relatedProject && (
                            <div class="experience-item__related">
                              <span class="experience-item__label">
                                {
                                  t.experience.labels
                                    .relatedProject
                                }
                              </span>

                              <a
                                href={
                                  item
                                    .relatedProject
                                    .href
                                }
                                class="experience-item__related-link"
                              >
                                {
                                  item
                                    .relatedProject
                                    .label
                                }

                                <span aria-hidden="true">
                                  ↗
                                </span>
                              </a>
                            </div>
                          )
                        }
                      </aside>
                    )
                  }
                </div>
              </div>
            </div>
          </article>
        );
      })
    }
  </div>
</section>

<script>
  import "./Experience.client";
</script>