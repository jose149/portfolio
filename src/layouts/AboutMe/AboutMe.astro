---
import SectionHeading from "../../components/SectionHeading/SectionHeading.astro";
import { aboutItems, aboutPrinciples } from "./AboutMe.data";
import "./AboutMe.scss";

interface Props {
  imageSrc?: string;
  imageAlt?: string;
}

const {
  imageSrc = "/images/portrait.png",
  imageAlt = "Portrait of Jose Crespí",
}: Props = Astro.props;
---

<section class="about-me" id="about" aria-labelledby="about-title">
  <header class="about-me__header">
    <SectionHeading id="about-title" title="About me" />
  </header>

  <div class="about-me__main">
    <figure class="about-me__portrait">
      <img
        class="about-me__portrait-image"
        src={imageSrc}
        alt={imageAlt}
        loading="lazy"
      />

      <div class="about-me__monogram" aria-hidden="true">JC</div>
    </figure>

    <div class="about-me__content">
      <div class="about-me__statement">
        <h3 class="about-me__statement-title">
          I turn complex product problems into clear, maintainable experiences.
        </h3>

        <span class="about-me__accent" aria-hidden="true"></span>

        <p class="about-me__statement-text">
          I like understanding why we build something before deciding how to
          build it.
        </p>
      </div>

      <div class="about-me__items">
        {
          aboutItems.map(({ number, title, text }) => (
            <article class="about-me__item">
              <div class="about-me__item-heading">
                <span class="about-me__item-number">{number}</span>
                <h4 class="about-me__item-title">{title}</h4>
              </div>

              <p class="about-me__item-text">{text}</p>
            </article>
          ))
        }
      </div>
    </div>
  </div>

  <div class="about-me__principles">
    <p class="about-me__principles-heading">Working principles</p>

    <div class="about-me__principles-list">
      {
        aboutPrinciples.map(({ title, text }) => (
          <article class="about-me__principle">
            <span class="about-me__principle-symbol" aria-hidden="true" />

            <div class="about-me__principle-content">
              <h4 class="about-me__principle-title">{title}</h4>
              <p class="about-me__principle-text">{text}</p>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
