---
import type { ProjectType } from "../../../../layouts/Projects/Projects.data";
import "./ProjectMeta.scss";
import ActionLink from "../../../ActionLink/ActionLink.astro";

interface Props {
  number: number;
  total?: number;
  project: ProjectType;
}

const { project } = Astro.props;

const {
  title,
  subtitle,
  description,
  purpose,
  contributionSummary,
  webCategory,
  role,
  stack,
  liveHref,
  liveLabel = "View live site",
  metrics,
} = project;

const featuredMetric = metrics?.[0];
---

<div class="project-meta">
  <div class="project-meta__header">
    <div class="project-meta__heading">
      <h3 class="project-meta__title">
        {title}
      </h3>
      <div class="project-meta__highlights">
        {role && <span class="project-meta__category">{role}</span>}
        {
          webCategory && (
            <span class="project-meta__category">{webCategory}</span>
          )
        }
      </div>
    </div>
  </div>

  <p class="project-meta__subtitle">
    {subtitle}
  </p>

  <p class="project-meta__description">
    {description}
  </p>

  <div class="project-meta__info">
    <div class="project-meta__info-block">
      <span class="project-meta__info-label"> Main stack </span>

      <div class="project-meta__stack">
        {
          stack.map((technology) => (
            <span class="project-meta__stack-item">{technology}</span>
          ))
        }
      </div>
    </div>
  </div>

  <div class="project-meta__summary">
    <div class="project-meta__summary-block">
      <span class="project-meta__info-label"> Problem </span>

      <p class="project-meta__summary-text">
        {purpose}
      </p>
    </div>

    <div class="project-meta__summary-block">
      <span class="project-meta__info-label"> Contribution </span>

      <p class="project-meta__summary-text">
        {contributionSummary}
      </p>
    </div>
  </div>

  <div class="project-meta__actions">
    {
      liveHref && (
        <div class="project-meta__primary-action">
          <ActionLink href={liveHref} variant="primary" fluid>
            {liveLabel}
          </ActionLink>
        </div>
      )
    }
  </div>
</div>
