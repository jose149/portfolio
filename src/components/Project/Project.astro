---
import type { ProjectType } from "../../layouts/Projects/Projects.types";

import "./Project.scss";

import ProjectHero from "./components/ProjectHero/ProjectHero.astro";
import ProjectCaseStudy from "./components/ProjectCaseStudy/ProjectCaseStudy.astro";

interface Props {
  number: number;
  total?: number;
  project: ProjectType;
  reverse?: boolean;
}

const { number, total, project, reverse = false } = Astro.props;

const caseStudyId = `project-${project.id}-case-study`;
---

<article class:list={["project", reverse && "project--reverse"]} data-project>
  <ProjectHero
    number={number}
    total={total}
    project={project}
    reverse={reverse}
    caseStudyId={caseStudyId}
  />

  <div
    id={caseStudyId}
    class="project__expandable"
    data-project-panel
    aria-hidden="true"
    inert
  >
    <div class="project__expandable-inner">
      <ProjectCaseStudy project={project} />
    </div>
  </div>
</article>

<script>
  const projects = document.querySelectorAll<HTMLElement>("[data-project]");

  projects.forEach((project) => {
    const trigger = project.querySelector<HTMLButtonElement>(
      "[data-project-toggle]",
    );

    const panel = project.querySelector<HTMLElement>("[data-project-panel]");

    const label = trigger?.querySelector<HTMLElement>(
      "[data-project-toggle-label]",
    );

    if (!trigger || !panel) return;

    trigger.addEventListener("click", () => {
      const isExpanded = project.classList.toggle("project--expanded");

      trigger.setAttribute("aria-expanded", String(isExpanded));

      panel.setAttribute("aria-hidden", String(!isExpanded));

      panel.toggleAttribute("inert", !isExpanded);

      if (label) {
        label.textContent = isExpanded ? "Close case study" : "View case study";
      }
    });
  });
</script>
